APP_NAME="GUTS-ESS API"
APP_HOST=127.0.0.1
APP_PORT=10000
APP_ENV=production
APP_IMPORT=app.main:app

# Database
DB_DRIVER=mysql
DB_ENGINE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ess
DB_USER="ใส่_user_จริง"
DB_PASSWORD="ใส่_password_จริง"

# Frontend / CORS
FRONTEND_ORIGIN="http://localhost:8090"
FRONTEND_URL="http://localhost:8090"

# JWT Security
JWT_SECRET_KEY="ใส่_secret_key_จริง"
SECRET_KEY="ใส่_secret_key_เดียวกับ_JWT_SECRET_KEY"
JWT_ALGORITHM=HS256
ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Admin MFA
MFA_ISSUER_NAME="PBAC-System"

# Email settings (used by password reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER="ใส่อีเมลจริง"
SMTP_PASS="ใส่_app_password_จริง"
EMAIL_FROM="ใส่อีเมลผู้ส่งจริง"